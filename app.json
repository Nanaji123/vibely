{
  "expo": {
    "name": "Vibely",
    "slug": "vibely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vibely",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nanaji.vibely"
    },
    "android": {
      "package": "com.nanaji.vibely",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c14ee3bf-88a9-42b7-b8fa-568c5416b09b"
      }
    }
  }
}
